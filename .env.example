# Copia este archivo a .env y rellena los valores reales
# Clave secreta de Stripe (Dashboard -> Developers -> API keys)  ej: sk_test_...
STRIPE_SECRET_KEY=
# Secreto del webhook (Dashboard -> Developers -> Webhooks, o `stripe listen`)
STRIPE_WEBHOOK_SECRET=
# URL publica donde se sirve la web (para los redirects de Stripe)
PUBLIC_URL=http://127.0.0.1:4173
